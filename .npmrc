# This machine cannot reliably reach registry.npmjs.org; use the official npm
# mirror. The lockfile stores integrity hashes, not hosts, so switching back is
# a one-line change: delete this file (or point it at registry.npmjs.org).
registry=https://registry.npmmirror.com

# Electron and electron-builder fetch binaries from GitHub by default. Point
# them at the same mirror so `pnpm install` / `pnpm dist` work here; remove
# these two lines to use the official download hosts.
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
